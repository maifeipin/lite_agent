{
    "_comment_model_config": "模型相关配置 (llm / task_routing / committee) 已拆分到 conf.d/ 目录，由对应 conf.d/*.json 完整维护。复制 conf.d/*.json.example 为 *.json 后重启生效。",
    "bot_name": "VPS 助手",
    "session": {
        "ttl_minutes": 30,
        "max_history": 20,
        "max_history_bytes": 40000,
        "max_steps_per_goal": 30,
        "daily_token_limit": 5000000
    },
    "task_specs": {
        "author_model": "glm-5.3",
        "validator_model": "glm-5.3",
        "model_tiers": {
            "low": ["flash", "gemini-flash"],
            "standard": ["glm-5.3", "kimi-k3"],
            "high": ["gemini-pro", "doubao-pro"]
        },
        "capability_map": {
            "web.search": ["web_search"],
            "web.fetch": ["ops_web_fetch"],
            "system.inspect": ["ops_sys_status", "ops_read_logs", "ops_read_journal"],
            "workspace.execute": ["ops_workspace_run"]
        }
    },
    "security": {
        "allowed_users": [],
        "sandbox_paths": [
            "/var/log",
            "/root/down",
            "/root/script",
            "/root/cert",
            "/root/alert",
            "/root/mail-statement-parser"
        ],
        "blocked_commands": [
            "rm -rf /",
            "mkfs",
            "dd if=",
            "> /dev/sd",
            "shutdown",
            "reboot",
            "passwd"
        ]
    },
    "channels": {
        "feishu": {
            "enabled": true,
            "app_id": "cli_a9439c9bcaf8dcd4",
            "app_secret": "${FEISHU_APP_SECRET}",
            "admin_open_id": "ou_7135c531f7a77b6cb3ae8b27e5dc056b"
        },
        "telegram": {
            "enabled": true,
            "bot_token": "${TG_BOT_TOKEN}",
            "proxy": "socks5h://127.0.0.1:18988",
            "admin_chat_id": "7797851184"
        },
        "dingtalk": {
            "enabled": true,
            "client_id": "dingb2eadjfacycy1kuk",
            "client_secret": "${DINGTALK_CLIENT_SECRET}",
            "admin_staff_id": "0159465607-607470790"
        },
        "wecom": {
            "enabled": true,
            "push_url": "http://127.0.0.1:6969/send_message",
            "push_token": "${WECOM_PUSH_TOKEN}",
            "listen_port": 8899,
            "admin_userid": "ChenLi"
        },
        "wechat": {
            "enabled": false,
            "admin_wxid": "",
            "session_file": "data/wechat_session.json",
            "contexts_file": "data/wechat_contexts.json",
            "cursor_file": "data/wechat_cursor.json",
            "context_ttl_hours": 24,
            "context_max_sends": 10,
            "poll_timeout": 35,
            "max_msg_len": 2000
        },
        "api": {
            "enabled": true,
            "host": "127.0.0.1",
            "port": 8887,
            "auth_token": "${API_AUTH_TOKEN}",
            "guest_token": "${API_GUEST_TOKEN}"
        }
    },
    "rssdb": {
        "uri": "${RSSDB_URI}",
        "database": "rsslite"
    },
    "billing": {
        "script_dir": "/home/liteagent/mail-statement-parser"
    },
    "edge": {
        "_comment": "Edge Sentinel 阶段二下行指令。密钥(EDGE_HOT_PRIV_KEY/EDGE_HOT_PUBKEY/EDGE_ROOT_PUBKEY)与 EDGE_TOKEN 均在 .env, 不在此处。whitelist 与边缘 /opt/edge_sentinel/whitelist.json 必须一致 (可参考 edge_node/whitelist.json)。",
        "pull_enabled": true,
        "task_timeout_min": 10,
        "sync_wait_sec": 70,
        "nodes": [
            "vps2",
            "vps3",
            "bwg",
            "oracle1",
            "vps5"
        ],
        "whitelist": [
            {
                "cmd": "df",
                "allow_args": [
                    "-h",
                    "-i"
                ]
            },
            {
                "cmd": "free",
                "allow_args": [
                    "-m",
                    "-h",
                    "-g"
                ]
            },
            {
                "cmd": "w",
                "allow_args": []
            },
            {
                "cmd": "uptime",
                "allow_args": []
            },
            {
                "cmd": "vnstat",
                "allow_args": [
                    "-d",
                    "-h",
                    "-m",
                    "-5",
                    "--oneline"
                ],
                "allow_if": [
                    "eth0",
                    "eth1",
                    "ens3",
                    "enp3s0"
                ],
                "value_flags": [
                    "-i",
                    "--interface"
                ]
            },
            {
                "cmd": "cat",
                "allow_args": [],
                "allow_files": [
                    "/var/log/auth.log",
                    "/var/log/secure",
                    "/etc/ssh/sshd_config"
                ]
            },
            {
                "cmd": "journalctl",
                "allow_args": [
                    "--no-pager",
                    "-n",
                    "today",
                    "yesterday",
                    "1 hour ago",
                    "2 hours ago"
                ],
                "allow_if": [
                    "ssh",
                    "sshd"
                ],
                "value_flags": [
                    "-u",
                    "--since",
                    "--unit",
                    "-n"
                ]
            },
            {
                "cmd": "ss",
                "allow_args": [
                    "-tlnp",
                    "-tunlp"
                ]
            },
            {
                "cmd": "systemctl",
                "allow_args": [
                    "status"
                ],
                "allow_if": [
                    "ssh",
                    "sshd",
                    "fail2ban"
                ],
                "value_flags": []
            },
            {
                "cmd": "crontab",
                "allow_args": [
                    "-l"
                ]
            },
            {
                "cmd": "sha256sum",
                "allow_args": [],
                "allow_files": [
                    "/etc/passwd",
                    "/etc/ssh/sshd_config",
                    "/root/.ssh/authorized_keys",
                    "/opt/edge_sentinel/whitelist.json"
                ]
            },
            {
                "cmd": "md5sum",
                "allow_args": [],
                "allow_files": [
                    "/etc/passwd",
                    "/etc/ssh/sshd_config",
                    "/root/.ssh/authorized_keys",
                    "/opt/edge_sentinel/whitelist.json"
                ]
            },
            {
                "cmd": "tail",
                "allow_args": [
                    "-n",
                    "10",
                    "20",
                    "50",
                    "100",
                    "-f"
                ],
                "allow_files": [
                    "/var/log/auth.log",
                    "/var/log/secure",
                    "/var/log/syslog"
                ]
            },
            {
                "cmd": "ls",
                "allow_args": [
                    "-l",
                    "-la",
                    "-al",
                    "-h",
                    "-t",
                    "-r"
                ],
                "allow_files": [
                    "/opt/edge_sentinel",
                    "/var/log",
                    "/etc/ssh"
                ]
            }
        ],
        "alerts": {
            "enabled": true,
            "disk_percent": 85,
            "mem_percent": 90,
            "cpu_load": 5.0,
            "staleness_min": 30,
            "dedup_window_min": 10
        }
    },
    "v2ex": {
        "token": "${V2EX_TOKEN}"
    },
    "fleet": {
        "retransmit_timeout_sec": 120,
        "max_retries": 2,
        "nodes": [
            "vps2",
            "vps3",
            "bwg",
            "oracle1",
            "vps5"
        ]
    },
    "project_root": "/home/liteagent/lite_agent",
    "cron_jobs": [
        {
            "name": "证书过期检查",
            "time": "09:00",
            "command": "bash /root/down/check_cert_expiry.sh"
        },
        {
            "name": "Edge任务超时回收",
            "time": "every_minute",
            "skill": "ops_edge_cmd::edge_sweep"
        },
        {
            "_comment": "记忆蒸馏复盘 已迁移至 lite-agent 主进程后台线程 (memory_engine.lite_integration.start_distill_scheduler) - 启动 5 分钟后跑首次，之后每 24h 一次。这里 03:00 cron 因 ops_memory_distiller.py 读 LLM_API_KEY env 拿不到，会降级为规则蒸馏并提前消化未蒸馏消息，破坏后台 LLM 蒸馏数据源。删除避免冲突。"
        },
        {
            "name": "系统状态巡检",
            "time": "08:00",
            "command": "python3 -c \"import sys; sys.path.insert(0,'{root}'); from skills.ops_sys import ops_sys_status; print(ops_sys_status(detail=True))\""
        },
        {
            "name": "RSS 预计算",
            "time_range": {
                "start": 9,
                "end": 22,
                "minute": 50
            },
            "skill": "ops_rss::rss_precompute"
        },
        {
            "name": "RSS 精选推送",
            "time_range": {
                "start": 9,
                "end": 22,
                "minute": 3
            },
            "skill": "ops_rss::rss_push"
        },
        {
            "name": "每日健康巡检广播",
            "time": "23:50",
            "skill": "ops_self_check::daily_health"
        },
        {
            "name": "安全体检 (Sentinel)",
            "time": "04:30",
            "skill": "ops_sentinel::sentinel_scan",
            "kwargs": {
                "mode": "quick"
            }
        },
        {
            "name": "edge_health_sweep",
            "skill": "ops_edge_health::edge_health",
            "time": "*/10 * * * *"
        }
    ],
    "service_name": "lite-agent",
