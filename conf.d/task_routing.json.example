{
    "planner_model": "glm-5.3",
    "classifier_model": "glm-5.3",
    "route_rules": [
        {
            "type": "text",
            "model": "glm-5.3",
            "fallback": "flash",
            "allowed_models": [
                "glm-5.3",
                "kimi-k3",
                "glm-5.2",
                "doubao-pro",
                "flash",
                "gemini-flash",
                "nvidia-glm-5.2"
            ]
        },
        {
            "type": "code",
            "model": "glm-5.3",
            "fallback": "flash",
            "allowed_models": [
                "glm-5.3",
                "kimi-k3",
                "glm-5.2",
                "gemini-pro",
                "flash"
            ],
            "tools": [
                "ops_workspace_run"
            ]
        },
        {
            "type": "complex_reasoning",
            "model": "glm-5.3",
            "fallback": "kimi-k3",
            "allowed_models": [
                "glm-5.3",
                "kimi-k3",
                "glm-5.2",
                "doubao-pro",
                "gemini-pro"
            ]
        },
        {
            "type": "data_analysis",
            "model": "glm-5.3",
            "fallback": "flash",
            "allowed_models": [
                "glm-5.3",
                "kimi-k3",
                "glm-5.2",
                "doubao-pro",
                "flash",
                "gemini-flash"
            ],
            "tools": [
                "ops_billing_cost",
                "ops_logs_query",
                "ops_sys_status",
                "ops_workspace_run",
                "ops_web_fetch"
            ]
        }
    ],
    "max_parallel_subtasks": 3,
    "subtask_timeout_minutes": 15,
    "dag_max_depth": 5,
    "dag_max_total_steps": 30,
    "dag_max_total_tokens": 200000
}
