{
  "schema_version": 1,
  "description": "Lite Agent 架构门禁规则与过渡期例外清单 (E0 基线)",
  "rules": {
    "RULE_NO_DIRECT_PARSER_IMPORT": {
      "name": "禁止生产代码直接导入 Parser 模块",
      "description": "禁止 Agent 生产模块通过 import / from / importlib 直接导入 mail-statement-parser 内部模块 (mail_client, statement_parser, statement_db 等)，必须通过 MailCLI 或已声明的 integrations 适配器访问。"
    },
    "RULE_NO_CORE_REVERSE_DEPENDENCY": {
      "name": "禁止 core 通用运行时产生反向依赖",
      "description": "core/ 通用运行时不得新增对 skills/、scripts/ 或具体业务工作流 (如 BillingWorkflow) 的直接导入。"
    },
    "RULE_DYNAMIC_IMPORT_REGISTERED": {
      "name": "动态导入必须严格登记",
      "description": "禁止通过未登记的 importlib.import_module 或 __import__ 绕行跨仓或反向依赖门禁。"
    },
    "RULE_NO_CROSS_REPO_SYS_PATH": {
      "name": "禁止生产代码注入跨仓 sys.path",
      "description": "禁止生产代码动态修改 sys.path 引入外部未受管代码目录。"
    }
  },
  "exceptions": [
